# Used by docker-compose.prod.yml. Keep this file free of real credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=agentic_calendar_app_db
DATABASE_URL=postgresql://postgres:replace-with-a-url-safe-password@postgres:5432/agentic_calendar_app_db

APP_URL=https://calendar.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
DESCOPE_PROJECT_ID=your-descope-project-id
DESCOPE_MANAGEMENT_KEY=replace-with-your-descope-management-key
DESCOPE_CALENDAR_CONNECTION_ID=google-calendar
NEXT_PUBLIC_DESCOPE_PROJECT_ID=your-descope-project-id
